      ],
      "requiredEnv": {
        "NOA_JUKEBOX_RUNTIME_ONLY": "1"
      },
      "concurrency": "workflow_owned"
    },
    "jukebox.process": {
      "module": "jukebox",
      "workflow": "noa-jukebox.yml",
      "command": [
        "scripts/noa_jukebox_release.py"
      ],
      "requiredEnv": {
        "NOA_JUKEBOX_RUNTIME_ONLY": "1"
      },
      "concurrency": "workflow_owned"
    },
    "ai.daily_shorts": {
      "module": "ai_lab",
      "workflow": "noa-ai-worker.yml",
      "command": [
        "scripts/noa_daily_shorts.py"
