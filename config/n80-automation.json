  "runtimes": {
    "node": {
      "authority": "N80 Engine",
      "module": "ai_lab",
      "executor": "existing_noa_host",
      "entry": "runtime/node/worker.mjs",
      "operations": [
        "engine.status",
        "ai.muvy"
      ],
      "queue": "existing_muvy_operations",
      "permission": "existing_signed_lab_worker",
      "completion": "existing_lease_and_completion_hash",
      "deadlineSeconds": 240,
      "maxTasksPerTick": 24,
      "daemon": false,
      "maxTasksPerInvocation": 1,
      "tickBudgetSeconds": 1200,
      "transport": "existing_n80_auto_tool_channel",
      "tools": [
        "n80_status",
        "muvy_claim",
        "muvy_provider",
        "muvy_complete",
        "muvy_failed"
      ]
    },
    "media": {
      "authority": "N80 Engine",
      "module": "ai_lab",
      "executor": "existing_noa_host",
      "entry": "runtime/media/host-runner.mjs",
      "queue": "existing_session_shorts_assembly",
      "permission": "existing_signed_lab_worker",
      "completion": "existing_assembly_lease_and_receipt",
      "deadlineSeconds": 600,
      "maxTasksPerInvocation": 1,
      "daemon": false,
      "transport": "existing_n80_auto_ssh"
    }
  }
}
